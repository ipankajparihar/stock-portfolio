# Copy to .env.local and fill in. Never commit .env.local — it holds real secrets.

# Neon Postgres pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (unpooled) connection. Optional — some drizzle-kit operations prefer it.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Session signing secret: openssl rand -base64 32
AUTH_SECRET="generate-me"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must include: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxx"
